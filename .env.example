# Copy to .env.local and change these before deploying.
# Long random string used to sign login cookies (e.g. run: openssl rand -hex 32)
AUTH_SECRET=
# The one admin account (customers register themselves from /dashboard)
ADMIN_EMAIL=admin@crunchs.com
ADMIN_PASSWORD=
# Data (menu, hours, staff, reviews, payroll, messages) lives in server memory only —
# nothing is written to disk, and it resets whenever the server restarts.
# For real persistence, point lib/store.ts at a hosted database instead.
